# Cohere API Key (Required for AI test script generation, translation, and RAG)
# Obtain your key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Selenium Execution Settings
# Set HEADLESS=0 to watch the browser execution in visible window mode
HEADLESS=1
SELENIUM_WAIT_SECONDS=15
